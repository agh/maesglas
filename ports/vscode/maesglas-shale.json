    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#F1F6F0",
        "fontStyle": ""
      }
    },
    {
      "scope": "attribute",
      "settings": {
        "foreground": "#C9EDEE",
        "fontStyle": ""
      }
    },
    {
      "scope": "tag",
      "settings": {
        "foreground": "#C9EDEE",
        "fontStyle": ""
      }
    },
    {
      "scope": "label",
      "settings": {
        "foreground": "#C9EDEE",
        "fontStyle": ""
      }
    },
    {
      "scope": "constructor",
      "settings": {
        "foreground": "#C9EDEE",
        "fontStyle": ""
      }
