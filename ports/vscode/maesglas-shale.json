      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#DECCEA",
        "fontStyle": ""
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#B2D8B6",
        "fontStyle": ""
      }
    },
    {
      "scope": "number",
      "settings": {
        "foreground": "#FBDCB2",
        "fontStyle": ""
      }
    },
    {
