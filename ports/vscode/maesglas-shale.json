      "settings": {
        "foreground": "#FBDCB2",
        "fontStyle": ""
      }
    },
    {
      "scope": "function",
      "settings": {
        "foreground": "#9FBDD5",
        "fontStyle": ""
      }
    },
    {
      "scope": "type",
      "settings": {
        "foreground": "#C9EDEE",
        "fontStyle": ""
