[delta "maesglas-chalk"]
    light = true
    syntax-theme = maesglas-chalk
    minus-style = "syntax #FAE9E5"
    plus-style = "syntax #E6F1E6"
    minus-emph-style = "#14231E #F7E1DB"
    plus-emph-style = "#14231E #DCEBDC"
    zero-style = "syntax #F1F5F0"
    line-numbers-minus-style = "#404D44"
    line-numbers-plus-style = "#404D44"
    line-numbers-zero-style = "#404D44"
    line-numbers-left-style = "#404D44"
    line-numbers-right-style = "#404D44"
    file-style = "bold #14231E"
    file-decoration-style = "#53655E box"
    hunk-header-style = "#2D475A"
    hunk-header-decoration-style = "#53655E box"
    keep-plus-minus-markers = true
